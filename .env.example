
# Application
APP_NAME=Production RAG
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/production_rag

# LLM provider
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=

# Embedding provider
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
